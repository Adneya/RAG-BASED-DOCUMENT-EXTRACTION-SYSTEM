APP_NAME=Multi-Input Agent
MAX_UPLOAD_MB=25

# Required for Gemini chat and audio transcription.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_CHAT_MODEL=gemini-2.0-flash
GEMINI_AUDIO_MODEL=gemini-2.0-flash

# Optional YouTube transcript language preference.
YOUTUBE_TRANSCRIPT_LANGS=en,en-US,en-GB

# Optional cost estimate values for the model you deploy.
INPUT_PRICE_PER_MILLION_TOKENS=0
OUTPUT_PRICE_PER_MILLION_TOKENS=0

# Local RAG store and retrieval settings.
RAG_STORE_DIR=data/chroma
RAG_COLLECTION_NAME=documents
RAG_CHUNK_TOKENS=260
RAG_CHUNK_OVERLAP_TOKENS=45
RAG_TOP_K=5
RAG_EMBEDDING_DIMENSIONS=384

