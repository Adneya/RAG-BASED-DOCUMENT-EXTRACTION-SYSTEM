APP_NAME=Multi-Input Agent
MAX_UPLOAD_MB=25

# Required for open-ended LLM answers and audio transcription.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_TRANSCRIPTION_MODEL=whisper-1

# Optional YouTube transcript language preference.
YOUTUBE_TRANSCRIPT_LANGS=en,en-US,en-GB

# Optional cost estimate values for the model you deploy.
INPUT_PRICE_PER_MILLION_TOKENS=0
OUTPUT_PRICE_PER_MILLION_TOKENS=0

